{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "<rootDir>/../src/jest-transformer.js"
  },
  "moduleNameMapper": {
    "^@repo/database$": "<rootDir>/../src/__mocks__/@repo/database",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
