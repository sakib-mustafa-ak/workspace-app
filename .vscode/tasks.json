{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Local email verification prototype",
			"type": "shell",
			"command": "corepack",
			"args": [
				"pnpm",
				"--filter",
				"api",
				"dev:verification"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Local PostgreSQL (PGlite)",
			"type": "shell",
			"command": "corepack pnpm dlx @electric-sql/pglite-socket --db=C:/Projects/workspace-app/.cache/local-postgres --port=5433 --host=127.0.0.1 --max-connections=10",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Local Workspace API",
			"type": "shell",
			"command": "$env:DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:5433/postgres'; $env:NODE_ENV='development'; $env:LOCAL_PGLITE='true'; $env:MAIL_PROVIDER='recorder'; $env:DEV_MAIL_INBOX_ENABLED='true'; $env:APP_PUBLIC_BASE_URL='http://localhost:3000'; $env:CORS_ORIGINS='http://localhost:3000'; corepack pnpm --filter api start",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Local Workspace Web",
			"type": "shell",
			"command": "$env:NODE_ENV='development'; $env:NEXT_PUBLIC_API_URL='http://localhost:3000/api/v1'; corepack pnpm --filter web dev",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
