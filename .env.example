# ───────────────────────────────────────────────────────────────────────────
# Workspace OS — API environment variables
# Copy this file to `.env` at the repository root, then fill in the values.
# Only `apps/api/src/config/*` is allowed to read these variables.
# ───────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://workspace:workspace123@localhost:5433/workspace

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (JWT) — replace with strong random values in production
JWT_ACCESS_SECRET=replace_me_at_least_16_chars
JWT_REFRESH_SECRET=replace_me_at_least_16_chars_different
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Upload storage — `local` (dev only, ephemeral disk), `s3`
# (any S3-compatible bucket: AWS S3 or Cloudflare R2 via S3_ENDPOINT), or
# `vercel-blob` (Vercel Blob store; private blobs + signed URLs).
# All S3_* vars are REQUIRED when STORAGE_DRIVER=s3;
# BLOB_READ_WRITE_TOKEN is REQUIRED when STORAGE_DRIVER=vercel-blob
# (both validated at boot).
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=workspace-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BLOB_READ_WRITE_TOKEN=

# Stripe billing (Phase 3) — all optional. Billing stays "not configured" when
# absent. STRIPE_WEBHOOK_SECRET is REQUIRED once STRIPE_SECRET_KEY is set
# (validated at boot). Price IDs come from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# Sentry (Phase: go-live) — optional; observability is skipped when absent.
# Get values from https://<org>.sentry.io/settings/projects/<project>/keys/
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
